{
  "name": "tuplerone",
  "description": "A yet another tuple implementation",
  "keywords": [
    "tuple",
    "weakmap",
    "identity",
    "objects",
    "maps",
    "data structures",
    "immutability",
    "memoization",
    "hashing",
    "value objects"
  ],
  "main": "dist/tuplerone.cjs",
  "module": "dist/tuplerone.js",
  "typings": "dist/tuplerone.d.ts",
  "files": [
    "dist"
  ],
  "author": "slikts <dabas@untu.ms>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slikts/tuplerone.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=6.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "release": "pnpm build && changeset publish",
    "start": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prod": "pnpm lint && pnpm test -- --coverage",
    "deploy-docs": "ts-node tools/gh-pages-publish",
    "report-coverage": "cat ./coverage/lcov.info | coveralls"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "prettier --write",
      "git add"
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^16.4.10",
    "@vitest/coverage-v8": "^4.0.18",
    "colors": "^1.4.0",
    "coveralls": "^3.1.0",
    "cross-env": "^7.0.3",
    "husky": "^6.0.0",
    "lint-staged": "^13.2.2",
    "prettier": "^2.3.2",
    "prompt": "^1.3.0",
    "replace-in-file": "^6.2.0",
    "ts-node": "^9.1.1",
    "tsdown": "0.21.0-beta.2",
    "tslint": "^5.20.1",
    "tslint-config-prettier": "^1.18.0",
    "tslint-config-slikts": "^2.0.4",
    "typescript": "6.0.0-beta",
    "typestrict": "1.0.2",
    "vitest": "^4.0.18"
  },
  "bugs": "https://github.com/slikts/tuplerone/issues",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "pnpm test:prod && pnpm build"
    }
  }
}
